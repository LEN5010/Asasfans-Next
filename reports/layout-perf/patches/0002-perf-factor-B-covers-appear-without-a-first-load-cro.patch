From 64f2408d9dda2f3fea6e991c0712794c5c1fc8bd Mon Sep 17 00:00:00 2001
From: LEN5010 <1649211052@qq.com>
Date: Sat, 26 Sep 2026 23:29:30 -0700
Subject: [PATCH 2/3] perf factor B: covers appear without a first-load
 cross-fade

---
 lib/shared/widgets/media_cover.dart | 31 +++++++++--------------------
 1 file changed, 9 insertions(+), 22 deletions(-)

diff --git a/lib/shared/widgets/media_cover.dart b/lib/shared/widgets/media_cover.dart
index 1ade184..2f35c6c 100644
--- a/lib/shared/widgets/media_cover.dart
+++ b/lib/shared/widgets/media_cover.dart
@@ -1,7 +1,5 @@
 import 'package:flutter/material.dart';
 
-import '../../app/theme/app_tokens.dart';
-import 'app_motion.dart';
 import 'media_image_policy.dart';
 
 /// Presentation-only CDN transform. Never mutate the URI kept by the model.
@@ -64,27 +62,16 @@ class MediaCover extends StatelessWidget {
               fit: fit,
               alignment: alignment,
               errorBuilder: (_, _, _) => _fallback(context),
-              // A network cover cross-fades from the loading tone; a cached
-              // one appears at once.
-              frameBuilder: (_, child, frame, synchronous) => synchronous
+              // The loading tone until the first frame, then the image at
+              // once: a cross-fade would keep two layers per tile on screen
+              // while a list scrolls in new covers.
+              frameBuilder: (_, child, frame, synchronous) =>
+                  synchronous || frame != null
                   ? child
-                  : AnimatedSwitcher(
-                      duration: appMotion(context, AppTokens.controlMotion),
-                      layoutBuilder: (current, previous) => Stack(
-                        fit: StackFit.expand,
-                        children: [...previous, ?current],
-                      ),
-                      child: frame == null
-                          ? ColoredBox(
-                              key: const ValueKey(false),
-                              color: Theme.of(
-                                context,
-                              ).colorScheme.surfaceContainerHighest,
-                            )
-                          : KeyedSubtree(
-                              key: const ValueKey(true),
-                              child: child,
-                            ),
+                  : ColoredBox(
+                      color: Theme.of(
+                        context,
+                      ).colorScheme.surfaceContainerHighest,
                     ),
             ),
           )
-- 
